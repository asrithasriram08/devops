
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('Exercise 9 - Jenkins Multi-Stage Pipeline') {
                    sh 'python3 -m pip install --user --break-system-packages -r requirements.txt'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercise 9 - Jenkins Multi-Stage Pipeline') {
                    sh 'python3 -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    rm -rf "$WORKSPACE/python-app-deploy"
                    mkdir -p "$WORKSPACE/python-app-deploy"
                    cp "$WORKSPACE/Exercise 9 - Jenkins Multi-Stage Pipeline/app.py" "$WORKSPACE/Exercise 9 - Jenkins Multi-Stage Pipeline/requirements.txt" "$WORKSPACE/python-app-deploy/"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
