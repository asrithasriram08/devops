#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet stream,
  /app/** rwk,
  /usr/local/bin/python* rix,
  /usr/local/lib/** r,
  deny /etc/** r,
  deny /bin/** rmix,
  deny /usr/bin/** rmix,
  deny /etc/shadow r,
  deny /var/** rw,
  deny capability sys_admin,
}
